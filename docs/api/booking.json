  "/bookings/{booking_id}/rate": {
   "post": {
    "description": "``booking.rated`` feeds the owner's record and becomes a review. It is\ndated at the end of the booked window, not when the buyer got round to it.",
    "operationId": "rate_bookings__booking_id__rate_post",
    "parameters": [
     {
      "in": "path",
      "name": "booking_id",
      "required": true,
      "schema": {
       "title": "Booking Id",
       "type": "string"
      }
