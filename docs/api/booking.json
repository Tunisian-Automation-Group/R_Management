 "info": {
  "title": "Cappy booking",
  "version": "1.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/bookings": {
   "get": {
    "description": "What the caller asked for (``role=requester``), is being asked for\n(``role=owner``), or both, newest first.",
    "operationId": "list_bookings_bookings_get",
    "parameters": [
     {
      "in": "query",
      "name": "role",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "pattern": "^(requester|owner)$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Role"
      }
     },
     {
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Cursor"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "minimum": 1,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page_Booking_"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "List Bookings"
   },
   "post": {
    "description": "Send the same ``Idempotency-Key`` when retrying: a retry returns the\nbooking the first attempt made, rather than a second booking.",
    "operationId": "create_booking_bookings_post",
    "parameters": [
     {
      "in": "header",
      "name": "idempotency-key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 80,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Idempotency-Key"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateBookingIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BookingCreated"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Create Booking"
   }
  },
