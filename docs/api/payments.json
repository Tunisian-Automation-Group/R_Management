{
 "components": {
  "schemas": {
   "Config": {
    "properties": {
     "provider": {
      "title": "Provider",
      "type": "string"
     },
     "publishableKey": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Publishablekey"
     }
    },
    "required": [
     "provider"
    ],
    "title": "Config",
    "type": "object"
   },
   "ConnectStatus": {
    "properties": {
     "connected": {
      "title": "Connected",
      "type": "boolean"
     },
     "detailsSubmitted": {
      "title": "Detailssubmitted",
      "type": "boolean"
     },
     "payoutsEnabled": {
      "title": "Payoutsenabled",
      "type": "boolean"
     }
    },
    "required": [
     "connected",
     "payoutsEnabled",
     "detailsSubmitted"
    ],
    "title": "ConnectStatus",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "IntentIn": {
    "properties": {
     "amount": {
      "exclusiveMinimum": 0.0,
      "maximum": 10000000.0,
      "title": "Amount",
      "type": "integer"
     },
     "bookingId": {
      "maxLength": 40,
      "title": "Bookingid",
      "type": "string"
     },
     "currency": {
      "pattern": "^[a-z]{3}$",
      "title": "Currency",
      "type": "string"
     },
     "ownerId": {
      "maxLength": 64,
      "title": "Ownerid",
      "type": "string"
     },
     "ownerNet": {
      "minimum": 0.0,
      "title": "Ownernet",
      "type": "integer"
     },
     "requesterId": {
      "maxLength": 64,
      "title": "Requesterid",
      "type": "string"
     }
    },
    "required": [
     "bookingId",
     "requesterId",
     "ownerId",
     "amount",
     "ownerNet",
     "currency"
    ],
    "title": "IntentIn",
    "type": "object"
   },
   "IntentOut": {
    "properties": {
     "clientSecret": {
      "title": "Clientsecret",
      "type": "string"
     },
     "intentId": {
      "title": "Intentid",
      "type": "string"
     }
    },
    "required": [
     "clientSecret",
     "intentId"
    ],
    "title": "IntentOut",
    "type": "object"
   },
   "Onboarding": {
    "properties": {
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "Onboarding",
    "type": "object"
   },
   "PaymentView": {
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "bookingId": {
      "title": "Bookingid",
      "type": "string"
     },
     "currency": {
      "title": "Currency",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "bookingId",
     "status",
     "amount",
     "currency"
    ],
    "title": "PaymentView",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
 "info": {
  "title": "Cappy payments",
  "version": "1.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/internal/intents": {
   "post": {
    "description": "Idempotent per booking: a retried booking gets the same intent back.\n\nNo database connection is held while Stripe answers: a slow Stripe must\nnot use up the pool that every other request needs.",
    "operationId": "create_intent_internal_intents_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/IntentIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/IntentOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Create Intent"
   }
  },
  "/payments/bookings/{booking_id}": {
   "get": {
    "operationId": "payment_for_booking_payments_bookings__booking_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "booking_id",
      "required": true,
      "schema": {
       "title": "Booking Id",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PaymentView"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Payment For Booking"
   }
  },
  "/payments/config": {
   "get": {
    "description": "What the app needs to load Stripe.js, or to know there is no card step.",
    "operationId": "config_payments_config_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Config"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Config"
   }
  },
  "/payments/connect/onboarding": {
   "post": {
    "description": "A Stripe-hosted page where an owner gives Stripe their identity and bank\ndetails. We never see either.",
    "operationId": "onboarding_payments_connect_onboarding_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Onboarding"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Onboarding"
   }
  },
  "/payments/connect/status": {
   "get": {
    "operationId": "connect_status_payments_connect_status_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ConnectStatus"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Connect Status"
   }
  },
  "/payments/webhooks/stripe": {
   "post": {
    "description": "The source of truth for what happened at Stripe. Signature-verified,\nand handled once per Stripe event id however often Stripe retries.",
    "operationId": "stripe_webhook_payments_webhooks_stripe_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Stripe Webhook Payments Webhooks Stripe Post",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Stripe Webhook"
   }
  }
 }
}
