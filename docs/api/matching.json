    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Offer"
         },
         "title": "Response Offers Listings  Listing Id  Offers Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Offers"
   }
  },
  "/matches": {
   "post": {
    "description": "Ranked capacity for a requirement. Your own listings are never results.",
    "operationId": "matches_matches_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/MatchesIn"
       }
      }
