      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Until"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 60,
       "maximum": 500,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
