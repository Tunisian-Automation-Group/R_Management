   "Availability": {
    "description": "A weekly schedule (H-4): the server keeps windows open from it, eight\nweeks ahead, in the listing's own time zone, so a listing never goes\ndark because nobody added windows by hand.",
    "properties": {
     "timeZone": {
      "default": "Europe/Berlin",
      "title": "Timezone",
      "type": "string"
     },
     "weekly": {
      "items": {
       "$ref": "#/components/schemas/WeeklyHours"
      },
      "maxItems": 21,
      "minItems": 1,
      "title": "Weekly",
      "type": "array"
     }
    },
    "required": [
     "weekly"
    ],
    "title": "Availability",
    "type": "object"
   },
