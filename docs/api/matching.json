 "info": {
  "title": "Cappy matching",
  "version": "1.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/browse/spotlight": {
   "get": {
    "description": "What is genuinely free near you soon, across every category.",
    "operationId": "spotlight_browse_spotlight_get",
    "parameters": [
     {
      "in": "query",
      "name": "district",
      "required": true,
      "schema": {
       "title": "District",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "maxKm",
      "required": false,
      "schema": {
       "default": 10,
       "exclusiveMinimum": 0,
       "maximum": 500,
       "title": "Maxkm",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "withinHours",
      "required": false,
      "schema": {
       "default": 24,
       "exclusiveMinimum": 0,
       "maximum": 336,
       "title": "Withinhours",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 12,
       "maximum": 60,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Spotlight"
         },
         "title": "Response Spotlight Browse Spotlight Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Spotlight"
   }
  },
  "/categories": {
   "get": {
    "operationId": "list_categories_categories_get",
    "parameters": [
     {
      "in": "query",
      "name": "group",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Group"
      }
     }
    ],
    "responses": {
