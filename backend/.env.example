# Copy to .env — docker compose reads it. Nothing here is secret in the demo.

# Postgres (one container, one database per service)
POSTGRES_USER=cappy
POSTGRES_PASSWORD=cappy

# Where slot timestamps are anchored when the demo world is seeded ("today at 18:00").
SEED_TIMEZONE=Europe/Berlin

# The account the frontend speaks for when no X-Cappy-User header is sent.
DEMO_USER_ID=o1

# Seeded hosts answer requests after this many seconds. 0 disables the simulation.
DEMO_AUTO_ACCEPT_SECONDS=5.5

# Origins allowed to call the gateway from a browser (comma-separated). The
# Vite dev server for local work; add the deployed website's origin (and a
# Capacitor shell's, e.g. capacitor://localhost) when the app is hosted apart
# from the API. An app served by the gateway itself needs no entry here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A built copy of the web app for the gateway to serve at / (see docker-compose).
# STATIC_DIR=../cappy/cappy/dist

# Development only: also allow any localhost port and private LAN addresses as browser
# origins (Vite moves to 5174 when 5173 is busy). Set to an empty string in production.
# CORS_ORIGIN_REGEX=
