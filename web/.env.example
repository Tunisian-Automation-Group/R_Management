
# The API. Leave unset: the app calls /api on its own origin, which the gateway
# serves in production and the Vite dev server proxies to VITE_API_PROXY
# (default http://localhost:8000). Set it only when the app is hosted apart from
# the API, e.g. VITE_API_URL=https://api.cappy.example/api
# VITE_API_URL=
