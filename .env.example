# Copy to .env (never committed) and fill in.

# LocalStack Pro, for S3/SNS/SQS/SES locally: https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# Optional: real Stripe test mode instead of the fake provider.
# COMPOSE_PROFILES=stripe     (runs the Stripe CLI that forwards webhooks)
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (docker run --rm stripe/stripe-cli listen --api-key $STRIPE_SECRET_KEY --print-secret)
