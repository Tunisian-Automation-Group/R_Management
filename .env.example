# Copy to .env (never committed) and fill in.

# LocalStack Pro, for S3/SNS/SQS/SES locally: https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# Optional: real Stripe test mode instead of the fake provider.
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen --forward-to localhost:8000/api/payments/webhooks/stripe`)
